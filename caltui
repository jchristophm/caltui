    #keys { width: 100%; height: 1; content-align: center middle;
            color: ansi_bright_black; background: ansi_default; }
    """

    def __init__(self, demo: bool = False, agenda: bool = False) -> None:
        super().__init__(ansi_color=True, driver_class=ColorDriver)
        self.secondary = "bright_black"
        self.accent = "cyan"
        self.palette = {}
        self._text_colors = {}
        self._palette_replies = {}
        self.demo = demo
        self.view = "agenda" if agenda else "calendar"
        self.layout_mode = "compact"
        self._agenda_size = None
        self._panel_style = None
        self._weather = None
        self._weather_requested = False
        self._reflow_pending = False
        self.page_starts = []
        self._page_position = None
        self._reset_position = True
        self.month = date.today().replace(day=1)
        self.anchor = date.today()
        self.selected = self.anchor
        self.feed_query = None
        self.pages: list[Text] = []
        self.page = 0
        self.page_offset = 0  # Relative to the page starting at the selected date.
        self.data_status = ""
        self.feed_queries = {}
        self.feed_modified = {}
        self.settings = Settings()
        self.configured_urls = []

    def compose(self) -> ComposeResult:
        with Container(id="stage"):
            with Container(id="calendar"):
                yield Static("", id="month")
                with Grid(id="weekdays"):
                    for name in ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"):
                        yield Static(name)
                with Grid(id="day-grid"):
                    for _ in range(42):
                        yield DayCell()
            with Container(id="agenda"):
                yield AgendaBody("", id="agenda-body")
            yield Static("", id="weather", markup=False)
        yield Static("", id="status")
        yield Static("", id="keys")

    def query_palette(self) -> None:
        if ColorDriver is not None and isinstance(self._driver, ColorDriver):
            self._palette_replies = {}
            self._driver.write(COLOR_QUERY)
            self._driver.flush()

    def on_palette_report(self, message: PaletteReport) -> None:
        self._palette_replies[message.key] = message.color
        if self._palette_replies.keys() == PALETTE_KEYS:
            palette = self._palette_replies.copy()
            if palette != self.palette:
                self.apply_palette(palette)

    def apply_palette(self, palette: dict[str, RGB]) -> None:
        self.palette = palette.copy()
        self._text_colors = colors = text_colors(palette)
        self.secondary = hex_color(colors["secondary"])
        self.accent = hex_color(colors["accent"])
        primary = hex_color(colors["primary"])
        self.screen.styles.color = primary
        for selector in ("#calendar", "#agenda", "#agenda-body", ".day"):
            for widget in self.query(selector):
                widget.styles.color = primary
        for selector in ("#weekdays", "#status", "#keys"):
            self.query_one(selector).styles.color = self.secondary
        self.query_one("#month").styles.color = self.accent
        self.render_view()

    def on_mount(self) -> None:
        self.query_palette()
        self.set_interval(2, self.query_palette)
        # Prepare the local snapshot before the first draw. Previously we
        # downloaded first, leaving a blank calendar until HTTP completed.
        try:
            urls, legacy, self.settings = read_config()
            self.configured_urls = urls
        except (OSError, ValueError) as error:
            if not self.demo:
                self.data_status = f"Invalid configuration: {error}"
                self.render_view()
                return
            self.notify(f"Invalid configuration: {error}; using demo defaults.", severity="error")
            urls = []
        if self.demo or not urls:
            self.feed_query = parse_feed(demo_ics())
            self.data_status = "Sample events · demo mode"
            self.render_view()
            return

        migrate_cache(legacy)
        for url in urls:
            try:
                self.feed_queries[url], self.feed_modified[url] = cached_feed(url)
            except Exception:
                pass
        self.feed_query = CombinedFeed(self.feed_queries.values()) if self.feed_queries else None
        self.data_status = (f"{len(self.feed_queries)} saved calendars" if self.feed_queries else "Loading calendar…")
        self.render_view()
        if any(url not in self.feed_modified or
               self.settings.stale(self.feed_modified[url]) for url in urls):
            self.load_feed(stale_only=True)

    def on_resize(self, event: events.Resize) -> None:
        self.call_after_refresh(self.render_view, False)
        self.schedule_reflow()

    def schedule_reflow(self) -> None:
        if not self._reflow_pending:
            self._reflow_pending = True
            self.call_after_refresh(self.reflow_agenda)

    def reflow_agenda(self) -> None:
        self._reflow_pending = False
        body = self.query_one("#agenda-body", Static)
        if body.region and (self.layout_mode != "compact" or self.view == "agenda"):
            size = body.content_size
            if size != self._agenda_size or self._reset_position:
                self._agenda_size = size
                self.rebuild_pages()
                self.render_view(rebuild=False)

    def action_calendar(self) -> None:
        if self.layout_mode != "compact":
            self.view = "calendar"
            return
        if self.view == "agenda":
            self.month = self.selected.replace(day=1)
        self.view = "calendar"
        self.render_view()

    def action_agenda(self) -> None:
        if self.layout_mode != "compact":
            self.view = "agenda"
            return
        # From a navigated month, start with that month rather than jumping to today.
        if self.view == "calendar" and self.month != self.anchor.replace(day=1):
            self.open_agenda(self.month)
        else:
            self.open_agenda(self.anchor)

    def open_agenda(self, day: date) -> None:
        self.selected = day
        self.anchor = day
        if self.layout_mode == "compact":
            self.view = "agenda"
        self.page_offset = 0
        self._reset_position = True
        self.render_view()

    def action_today(self) -> None:
        self.anchor = date.today()
        self.selected = self.anchor
        self.month = self.anchor.replace(day=1)
        self.page_offset = 0
        self._reset_position = True
        self.render_view()

    def move_selection(self, days: int = 0, months: int = 0) -> None:
        if self.layout_mode == "compact" and self.view != "calendar":
            return
        if months:
            first = month_shift(self.selected, months)
            self.selected = first.replace(day=min(self.selected.day,
                monthlib.monthrange(first.year, first.month)[1]))
        else:
            self.selected += timedelta(days=days)
        self.month = self.selected.replace(day=1)
        self.render_view(rebuild=False)

    def action_previous_day(self) -> None:
        self.move_selection(days=-1)

    def action_next_day(self) -> None:
        self.move_selection(days=1)

    def action_previous_month(self) -> None:
        self.move_selection(months=-1)

    def action_next_month(self) -> None:
        self.move_selection(months=1)

    def action_selected_agenda(self) -> None:
        if self.layout_mode != "compact" or self.view == "calendar":
            self.open_agenda(self.selected)

    def action_previous_page(self) -> None:
        if (self.layout_mode != "compact" or self.view == "agenda") and self.page > 0:
            self.page -= 1
            self.page_offset -= 1
            self.render_view(rebuild=False)

    def action_next_page(self) -> None:
        if (self.layout_mode != "compact" or self.view == "agenda") and self.page + 1 < len(self.pages):
            self.page += 1
            self.page_offset += 1
            self.render_view(rebuild=False)

    def action_settings(self) -> None:
        command = settings_editor()
        if command is None:
            self.notify("No terminal editor found. Set VISUAL or EDITOR, or install nano or vi.", severity="warning")
            return
        try:
            before = CONFIG.read_bytes() if CONFIG.is_file() else None
        except OSError:
            self.notify("Could not read config.toml; check its permissions.", severity="error")
            return
        completed = None
        try:
            with self.suspend():
                # Catch failures here so Textual reaches its terminal-resume code.
                try:
                    completed = subprocess.run([*command, str(CONFIG)], check=False)
                except (OSError, ValueError, KeyboardInterrupt):
                    pass
        except SuspendNotSupported:
            self.notify("Settings requires a terminal that supports suspending calTUI.", severity="warning")
            return
        if completed is None:
            self.notify("Could not run the settings editor. Check VISUAL or EDITOR.", severity="error")
            return
        if completed.returncode:
            self.notify(f"Settings editor exited with status {completed.returncode}.", severity="warning")
        try:
            after = CONFIG.read_bytes() if CONFIG.is_file() else None
            if after == before:
                return
            urls, _, settings = read_config()
        except (OSError, ValueError) as error:
            self.notify(f"Invalid configuration: {error}; keeping loaded settings and calendars.", severity="error")
            return
        previous = self.settings
        urls_changed = set(urls) != set(self.configured_urls)
        self.settings = settings
        self.configured_urls = urls
        if (previous.days_back, previous.days_forward) != (settings.days_back, settings.days_forward):
            self.render_view()
        if not self.demo and (urls_changed or previous.minutes != settings.minutes):
            self.load_feed(stale_only=True)

    def action_refresh_feed(self) -> None:
        if self.layout_mode == "wide":
            self._weather_requested = False
            self.call_after_refresh(self.render_weather)
        if self.demo:
            self.data_status = "Sample events · demo mode"
            self.render_view()
            return
        self.load_feed()

    @work(exclusive=True, group="feed")
    async def load_feed(self, stale_only: bool = False) -> None:
        try:
            urls, legacy, settings = read_config()
        except (OSError, ValueError) as error:
            self.data_status = f"Invalid configuration: {error}"
            self.render_view()
            return
        self.settings = settings
        self.configured_urls = urls
        migrate_cache(legacy)
        # Re-read subscriptions on R. Removed sources cease contributing at once.
        self.feed_queries = {url: query for url, query in self.feed_queries.items() if url in urls}
        self.feed_modified = {url: modified for url, modified in self.feed_modified.items() if url in urls}
        for url in urls:
            if url not in self.feed_queries:
                try:
                    query, modified = await asyncio.to_thread(cached_feed, url)
                    self.feed_queries[url], self.feed_modified[url] = query, modified
                except Exception:
                    pass
        self.feed_query = CombinedFeed(self.feed_queries.values()) if self.feed_queries else None
        if not urls:
            self.feed_query = parse_feed(demo_ics())
            self.data_status = "Sample events · demo mode"
            self.render_view()
            return
        self.data_status = "Checking calendars for updates…"
        self.render_view()
        updated, failed = 0, 0

        async def refresh(url: str) -> None:
            nonlocal updated, failed
            try:
                query = await asyncio.to_thread(refresh_feed, url)
                self.feed_queries[url] = query
                self.feed_modified[url] = clock.time()
                updated += 1
                self.feed_query = CombinedFeed(self.feed_queries.values())
                self.render_view()
            except Exception:
                failed += 1

        pending = [url for url in urls if not stale_only or url not in self.feed_modified or
                   self.settings.stale(self.feed_modified[url])]
        await asyncio.gather(*(refresh(url) for url in pending))
        cached = len(self.feed_queries) - updated
        unavailable = len(urls) - len(self.feed_queries)
        parts = [f"{updated} calendars updated"] if updated else []
        if cached:
            parts.append(f"{cached} using cache")
        if unavailable:
            parts.append(f"{unavailable} unavailable")
        self.data_status = " · ".join(parts) + (" · R to retry" if failed else "")
        self.render_view()

    def render_view(self, rebuild: bool = True) -> None:
        cal = self.query_one("#calendar", Container)
        agenda = self.query_one("#agenda", Container)
        stage = self.query_one("#stage", Container)
        width, height = self.size.width, max(0, self.size.height - (3 if self.size.height >= 6 else 2))
        stage.set_class(self.size.height < 6, "cramped")
        # The framed calendar needs 16 content rows + 2 border rows. Stacked
        # adds a one-row gap and an agenda with at least 8 content + 2 border rows.
        self.layout_mode = ("wide" if width >= 91 and height >= 18 else
                            "stacked" if width >= 36 and height >= 29 else "compact")
        for mode in ("wide", "stacked", "compact"):
            stage.set_class(mode == self.layout_mode, mode)
        stage.set_class(height < 16, "tiny")
        calendar_framed = width >= 32 and height >= 18
        agenda_height = height - 19 if self.layout_mode == "stacked" else height
        agenda_framed = width >= 28 and agenda_height >= 5
        cal.set_class(calendar_framed, "framed")
        agenda.set_class(agenda_framed, "framed")
        border = (hex_color(blend(self.palette["11"], self._text_colors["primary"], 96))
                  if self.palette else "ansi_bright_black")
        panel_style = (calendar_framed, agenda_framed, border)
        if panel_style != self._panel_style:
            self._panel_style = panel_style
            for panel, framed in ((cal, calendar_framed), (agenda, agenda_framed)):
                panel.styles.border = ("round" if framed else "none", border)
        combined = self.layout_mode != "compact"
        cal.display = combined or self.view == "calendar"
        agenda.display = combined or self.view == "agenda"
        if cal.display:
            self.render_calendar()
        if agenda.display:
            if rebuild and self.query_one("#agenda-body").content_size.width:
                self.rebuild_pages()
            self.query_one("#agenda-body", Static).update(
                self.pages[self.page] if self.pages else "No events")
            self.schedule_reflow()
        instructions = ("←→ Day Shift+←→ Month Enter Open · ↑↓ Page · T Today · S Settings · R Refresh · Q Quit" if combined else
                        "C Calendar · A Agenda · " +
                        ("←→ Day Shift+←→ Month Enter Open" if self.view == "calendar" else "↑↓ Page") +
                        " · T Today · S Settings · R Refresh · Q Quit")
        if len(instructions) > width:
            instructions = ("←→ Day ⇧←→ Month Enter Open ↑↓ Page T Today S Settings R Q" if combined else
                            "C/A View ←→ Day ⇧←→ Month Enter Open ↑↓ Page T R S Q")
        if len(instructions) > width:
            instructions = "Q C/A ←→ ↑↓ S Settings" if width >= 24 else "Q C A T R S" if width >= 11 else "Q S C A"
        self.query_one("#status", Static).update(shorten(self.data_status, width))
        self.query_one("#keys", Static).update(shorten(instructions, width))
        self.call_after_refresh(self.render_weather)

    @work(exclusive=True, group="weather")
    async def load_weather(self) -> None:
        process, report = None, None
        try:
            process = await asyncio.create_subprocess_exec(
                "curl", "-fsS", "--max-time", "4", "https://wttr.is/?0nq",
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
            output, _ = await asyncio.wait_for(process.communicate(), timeout=5)
            if process.returncode == 0 and len(output) <= 16384:
                report = Text.from_ansi(output.decode("utf-8").rstrip("\r\n"))
                plain = report.plain
                if (not plain.strip() or plain.lstrip().startswith("<") or
                        any((ord(c) < 32 and c != "\n") or 127 <= ord(c) < 160 for c in plain)):
                    report = None
        except (OSError, ValueError, asyncio.TimeoutError):
            pass
        finally:
            if process is not None and process.returncode is None:
                try:
                    process.kill()
                except ProcessLookupError:
                    pass
                await process.wait()
        self._weather = report
        self.call_after_refresh(self.render_weather)

    def render_weather(self) -> None:
        weather = self.query_one("#weather", Static)
        cal, stage = self.query_one("#calendar"), self.query_one("#stage")
        available = stage.content_region.bottom - cal.region.bottom - 1
        possible = self.layout_mode == "wide" and cal.region.width > 0 and available > 0
        if possible and not self._weather_requested:
            self._weather_requested = True
            self.load_weather()
        lines = self._weather.split("\n") if self._weather is not None else []
        width = max((line.cell_len for line in lines), default=0)
        fits = possible and len(lines) >= 2 and width > 0 and width <= cal.region.width and len(lines) <= available
        weather.display = fits
        if fits:
            weather.styles.width, weather.styles.height = width, len(lines)
            weather.styles.offset = (cal.region.x - stage.content_region.x + (cal.region.width - width) // 2,
                                     cal.region.bottom - stage.content_region.y + 1)
            weather.update(self._weather)

    def render_calendar(self) -> None:
        first = self.month
        last = month_shift(first, 1)
        marked: set[date] = set()
        if self.feed_query is not None:
            try:
                begin, end = self.settings.window()
                begin, end = max(first, begin), min(last, end)
                if begin < end:
                    for day, _ in day_groups(parse_appointments(self.feed_query, begin, end), begin, end):
                        marked.add(day)
            except Exception:
                self.data_status = "Some calendar events could not be read"
        self.query_one("#month", Static).update("‹   " + first.strftime("%B %Y") + "   ›")
        start_offset = first.weekday()
        cells = self.query(".day")
        length = monthlib.monthrange(first.year, first.month)[1]
        for i, cell in enumerate(cells):
            n = i - start_offset + 1
            active = 1 <= n <= length
            cell.day = first.replace(day=n) if active else None
            cell.set_class(bool(active and cell.day == self.selected), "selected")
            cell.set_class(bool(active and cell.day in marked), "has-event")
            if self.palette:
                colors = self._text_colors
                cell.styles.color = hex_color(colors["selection"] if cell.has_class("selected") else
                                              colors["accent"] if cell.has_class("has-event") else colors["primary"])
                cell.styles.background = (hex_color(self.palette["4;4"])
                                          if cell.has_class("selected") else "ansi_default")
            if active:
                cell.update(f"{n:2d}" + ("\n•" if cell.day in marked else ""))
            else:
                cell.update("")

    def rebuild_pages(self) -> None:
        size = self.query_one("#agenda-body", Static).content_size
        width, height = size.width, size.height
        if self._reset_position:
            self._page_position = None
        elif self.page < len(self.page_starts):
            self._page_position = self.page_starts[self.page]
        previous = self._page_position
        if width < 24 or height < 3:
            self.pages = agenda_pages([], height, width, secondary=self.secondary, accent=self.accent)
            self.page_starts = []
            self.page = 0
            self._reset_position = False
            return
        self.page_starts = []
        if self.feed_query is None:
            self._reset_position = False
            self.pages = [Text("No calendar loaded", style=self.secondary)]
            self.page = 0
            return
        try:
            begin, end = self.settings.window()
            events = parse_appointments(self.feed_query, begin, end)
            groups = day_groups(events, begin, end)

            # The selected day must be the start of the initial agenda page.
            # Keep earlier appointments as preceding pages, rather than
            # throwing them away as the original forward-only viewer did.
            earlier = [g for g in groups if g[0] < self.anchor]
            onward = [g for g in groups if g[0] >= self.anchor]
            earlier_pages = agenda_pages(earlier, height, width, self.page_starts, self.secondary, self.accent) if earlier else []
            onward_pages = agenda_pages(onward, height, width, self.page_starts, self.secondary, self.accent)
            self.pages = earlier_pages + onward_pages
            anchor_page = len(earlier_pages)
            self.page = max(0, min(anchor_page + self.page_offset, len(self.pages) - 1))
            if previous is not None and self.page_starts:
                self.page = max((i for i, start in enumerate(self.page_starts)
                                 if start <= previous), default=0)
            self.page_offset = self.page - anchor_page
            self._reset_position = False
        except Exception:
            self.pages = [Text("Could not read agenda events", style=self.secondary)]
            self.page = 0


def main() -> None:
    cli = argparse.ArgumentParser(description="Small read-only calendar and agenda TUI")
    cli.add_argument("--demo", action="store_true", help="Show sample events without a subscription")
    cli.add_argument("-a", "--agenda", action="store_true", help="Start in agenda view")
    output = cli.add_mutually_exclusive_group()
    output.add_argument("--next", action="store_true", help="Print the next future timed event as JSON")
    output.add_argument("--waybar", action="store_true", help="Print the next timed event as Waybar JSON")
    cli.add_argument("--within", type=positive_minutes, metavar="N",
                     help="With --next or --waybar, limit the start time to N minutes from now")
    args = cli.parse_args()
    if args.within is not None and not (args.next or args.waybar):
        cli.error("--within requires --next or --waybar")
    if args.next or args.waybar:
        try:
            query = next_feed(demo=args.demo)
            now = datetime.now(LOCAL_TZ)
            result = next_event(query, now, args.within)
            if args.waybar:
                result = waybar_event(result, now.date())
        except Exception as error:
            print(f"calTUI: Calendar unavailable: {error}", file=sys.stderr)
            if args.waybar:
                print(json.dumps({"text": "", "tooltip": "Calendar unavailable; check the feed configuration and cache",
                                  "class": "error"}))
                return
            print(json.dumps({"date": "", "time": "", "description": "", "location": ""}))
            raise SystemExit(1)
        print(json.dumps(result, ensure_ascii=False))
        return
    CalTUI(demo=args.demo, agenda=args.agenda).run()

if __name__ == "__main__":
    main()
