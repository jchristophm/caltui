def settings_editor() -> list[str] | None:
    for command in (os.environ.get("VISUAL", ""), os.environ.get("EDITOR", ""), "nano", "vi"):
        try:
            argv = shlex.split(command)
            executable = shutil.which(argv[0]) if argv else None
        except (OSError, ValueError):
            continue
        if executable:
            return [executable, *argv[1:]]
    return None


@dataclass(frozen=True)
class Settings:
    days_back: int = AGENDA_DAYS_BACK
    days_forward: int = AGENDA_DAYS_FORWARD
    minutes: int = 30

    @classmethod
    def from_config(cls, config: dict) -> Settings:
        values = {}
        # Cap each side at a year to bound recurrence expansion. One minute
        # prevents sub-minute polling; one week bounds how stale feeds may be.
        for section, key, default, maximum in (
            ("agenda", "days_back", 30, 366),
            ("agenda", "days_forward", 120, 366),
            ("refresh", "minutes", 30, 10080),
        ):
            table = config.get(section, {})
            if not isinstance(table, dict):
                raise ValueError(f"{section} must be a TOML table")
            value = table.get(key, default)
            if type(value) is not int or not 1 <= value <= maximum:
                raise ValueError(f"{section}.{key} must be an integer from 1 to {maximum}")
            values[key] = value
        return cls(**values)

    def window(self) -> tuple[date, date]:
        today = date.today()
        return today - timedelta(days=self.days_back), today + timedelta(days=self.days_forward + 1)

    def stale(self, modified: float) -> bool:
        return max(0, clock.time() - modified) >= self.minutes * 60


def read_config() -> tuple[list[str], str, Settings]:
    """Configured URLs in order, plus the unambiguous owner of the old cache."""
    if not CONFIG.is_file():
        return [], "", Settings()
    with CONFIG.open("rb") as handle:
        config = tomllib.load(handle)
    settings = Settings.from_config(config)
    legacy = str(config.get("url", "")).strip()
    entries = config.get("calendars", [])
    if not isinstance(entries, list) or any(not isinstance(entry, dict) for entry in entries):
        raise ValueError("calendars must be an array of tables")
    urls = list(dict.fromkeys(url for value in [legacy, *(entry.get("url", "") for entry in entries)]
                              if (url := str(value).strip())))
    if any(not url.startswith("https://") for url in urls):
        raise ValueError("Feed URLs must begin with https://")
    return urls, legacy or (urls[0] if len(urls) == 1 else ""), settings


def subscription_urls() -> tuple[list[str], str]:
    urls, legacy, _ = read_config()
    return urls, legacy


def cache_path(url: str | None = None) -> Path:
    return CACHE if url is None else CACHE.parent / (hashlib.sha256(url.encode()).hexdigest() + ".ics")


def migrate_cache(url: str) -> None:
    """Consume the old unassigned snapshot once, without replacing a newer one."""
    if not url or not CACHE.is_file():
        return
    try:
        parse_feed(CACHE.read_bytes())
        path = cache_path(url)
        try:
            os.link(CACHE, path)  # Atomic, exclusive; preserve the original mtime.
        except FileExistsError:
            parse_feed(path.read_bytes())
        path.chmod(0o600)
        CACHE.unlink()
    except (OSError, ValueError):
        pass  # The hashed cache or the ordinary download can still be used.


def download_ics(url: str) -> bytes:
    request = Request(url, headers={"User-Agent": "CalTUI/0.1", "Accept": "text/calendar, */*"})
    with urlopen(request, timeout=15) as response:
        data = response.read(MAX_FEED_BYTES + 1)
    if len(data) > MAX_FEED_BYTES:
        raise ValueError("Calendar feed is too large")
    if b"BEGIN:VCALENDAR" not in data[:2048]:
        raise ValueError("Subscription did not return an ICS calendar")
    return data


def parse_feed(data: bytes, *, timed_only: bool = False) -> object:
    """Validate and prepare an ICS snapshot without altering the current view."""
    calendar = Calendar.from_ical(data)
    if calendar.name != "VCALENDAR":
        raise ValueError("Subscription must contain an ICS calendar")
    query = recurring_ical_events.of(calendar)
    if not timed_only:
        return query
    # Avoid iterating endless all-day/cancelled recurrences in --next mode.
    # Keep whole UID families so EXDATE and recurrence overrides still apply.
    timed_uids = {
        str(item.get("UID", "")) for item in calendar.subcomponents
        if item.name == "VEVENT" and "DTSTART" in item
        and isinstance(item.decoded("DTSTART"), datetime)
        and str(item.get("STATUS", "")).upper() != "CANCELLED"
    }
    calendar.subcomponents = [
        item for item in calendar.subcomponents
        if item.name != "VEVENT" or str(item.get("UID", "")) in timed_uids
    ]
    return recurring_ical_events.of(calendar)


def cached_feed(url: str | None = None, *, timed_only: bool = False) -> tuple[object, float]:
    """Read the last good snapshot locally; never wait for the network."""
    path = cache_path(url)
    query = parse_feed(path.read_bytes(), timed_only=timed_only)
    return query, path.stat().st_mtime


def save_private_cache(data: bytes, url: str | None = None) -> None:
    path = cache_path(url)
    CACHE.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, name = tempfile.mkstemp(dir=CACHE.parent, prefix=".calendar-", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.chmod(name, 0o600)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def refresh_feed(url: str, *, timed_only: bool = False) -> object:
    data = download_ics(url)
    query = parse_feed(data, timed_only=timed_only)
    save_private_cache(data, url)  # Parse successfully before replacing a snapshot.
    return query


def next_feed(demo: bool = False) -> object:
    """Load each CLI snapshot, refreshing stale sources with independent fallback."""
    if demo:
        return parse_feed(demo_ics(), timed_only=True)
    urls, legacy, settings = read_config()
    if not urls:
        raise ValueError("No calendar feed configured")
    migrate_cache(legacy)
    queries, failed = [], 0
    for url in urls:
        query = None
        try:
            query, modified = cached_feed(url, timed_only=True)
            if not settings.stale(modified):
                queries.append(query)
                continue
        except Exception:
            pass
        try:
            query = refresh_feed(url, timed_only=True)
        except Exception:
            failed += 1
        if query is not None:
            queries.append(query)
    if not queries:
        raise ValueError("No calendars available")
    if failed:
        print(f"calTUI: {failed} calendar refresh failed; using available calendars and saved data", file=sys.stderr)
    return CombinedFeed(queries)


def next_event(query: object, now: datetime, within: float | None = None) -> dict[str, str]:
    """Return the first future timed occurrence, without a fixed search horizon."""
    empty = {"date": "", "time": "", "description": "", "location": ""}
    now = local_datetime(now)

    def future_items(items):
        for item in items:
            if str(item.get("STATUS", "")).upper() == "CANCELLED" or "DTSTART" not in item:
                continue
            raw_start = item.decoded("DTSTART")
            if not isinstance(raw_start, datetime):
                continue
            start = local_datetime(raw_start)
            # Compare actual instants, including across DST transitions.
            if start.timestamp() > now.timestamp():
                yield start, item

    # Select within each recurrence context, then compare actual instants.
    candidates = []
    for source in query.queries if isinstance(query, CombinedFeed) else (query,):
        candidate = next(future_items(source.after(now)), None)
        if candidate is not None:
            # Mixed floating/UTC times can be ordered differently by the library.
            candidates.append(min(future_items(source.between(now, candidate[0])),
                                  key=lambda pair: pair[0].timestamp(), default=candidate))
    if not candidates:
        return empty
    start, item = min(candidates, key=lambda pair: pair[0].timestamp())
    if within is not None and (start.timestamp() - now.timestamp()) / 60 > within:
        return empty
    return {
        "date": start.date().isoformat(),
        "time": start.strftime("%I:%M %p").lstrip("0"),
        "description": str(item.get("SUMMARY", "")),
        "location": str(item.get("LOCATION", "")),
    }


def waybar_event(result: dict[str, str], today: date) -> dict[str, str]:
    """Format the existing next-event result for Waybar, without changing --next."""
    if not result["date"]:
        return {"text": "", "tooltip": "No upcoming timed appointments", "class": "empty"}

    def clean(value: str) -> str:
        # Remove complete ANSI CSI / OSC sequences before stripping controls.
        value = re.sub(r"(?:\x1b\]|\x9d)[^\a\x1b\x9c]*(?:\a|\x1b\\|\x9c)|(?:\x1b\[|\x9b)[0-?]*[ -/]*[@-~]|\x1b[ -/]*[0-~]", "", value)
        value = "".join(" " if char.isspace() else char
                        for char in value if char.isspace() or category(char) not in {"Cc", "Cf", "Cs"})
        return " ".join(value.split())

    day = date.fromisoformat(result["date"])
    when = clean(result["time"])
    title = clean(result["description"]) or "(Untitled)"
    location = clean(result["location"])
    brief = title if len(title) <= 48 else title[:47] + "…"
    prefix = "" if day == today else day.strftime("%a %b %-d · ")
    tooltip = [day.strftime("%A, %B %-d, %Y"), when, title]
    if location:
        tooltip.append(location)
    # Waybar uses Pango markup by default. Feed text must remain literal text.
    return {"text": escape(prefix + when + " · " + brief, quote=False),
            "tooltip": escape("\n".join(tooltip), quote=False), "class": "upcoming"}


def positive_minutes(value: str) -> float:
    try:
        minutes = float(value)
    except ValueError:
        raise argparse.ArgumentTypeError("--within must be a positive number of minutes") from None
    if not math.isfinite(minutes) or minutes <= 0:
        raise argparse.ArgumentTypeError("--within must be a positive number of minutes")
    return minutes


def day_groups(items: list[Appointment], begin: date, stop: date) -> list[tuple[date, list[Appointment]]]:
    dates: dict[date, list[Appointment]] = {}
    for item in items:
        for day in item.days(begin, stop):
            dates.setdefault(day, []).append(item)
    return sorted(dates.items())


def valid_web_url(url: str) -> bool:
    """Validate click targets without interpreting calendar text as commands."""
    try:
        parsed = urlsplit(url)
        return (parsed.scheme.lower() in {"http", "https"} and bool(parsed.hostname)
                and parsed.port != 0 and not any(c.isspace() or ord(c) < 32 for c in url)
                and not any(c in url for c in "\\<>\""))
    except ValueError:
        return False


def location_text(location: str, width: int, secondary: str) -> Text:
    text = Text(location, style=secondary)
    for match in re.finditer(r"(?<![\w:/])https?://[^\s<>\"]+", location, re.IGNORECASE):
        url = match.group().rstrip(".,;:!?'")
        # Keep balanced URL parentheses, but discard prose closing delimiters.
        for opening, closing in (("(", ")"), ("[", "]"), ("{", "}")):
            while url.endswith(closing) and url.count(closing) > url.count(opening):
                url = url[:-1]
        if valid_web_url(url):
            text.stylize(Style(underline=True, meta={"meeting_url": url}),
                         match.start(), match.start() + len(url))
    text.truncate(max(1, width), overflow="ellipsis")
    return text


def event_line(item: Appointment, day: date, width: int, secondary: str = "bright_black") -> list[Text]:
    if item.all_day:
        when = "All day"
    elif item.start.date() < day:
        when = "Cont."
    else:
        when = item.start.strftime("%I:%M %p").lstrip("0")
    prefix = f"{when:<10} "
    title = shorten(item.title, width - len(prefix))
    # Let times and titles inherit Foot's normal foreground, like calendar day numbers.
    line = Text(prefix)
    line.append_text(title)
    lines = [line]
    if item.location:
        detail = Text(" " * 11 + "↳ ", style=secondary)
        detail.append_text(location_text(item.location, width - 13, secondary))
        detail.stylize(secondary)
        lines.append(detail)
    return lines


def agenda_pages(groups: list[tuple[date, list[Appointment]]], height: int, width: int,
                 starts: list | None = None, secondary: str = "bright_black",
                 accent: str = "cyan") -> list[Text]:
    """Fit complete appointments (including locations) on pages; never scroll."""
    if height < 3 or width < 24:
        return [Text("Enlarge window to view agenda", style=secondary)]
    pages: list[Text] = []
    current: list[Text] = []
    used = 0

    def flush() -> None:
        nonlocal current, used
        if current:
            text = Text("\n").join(current)
            text.no_wrap = True
            text.overflow = "crop"
            pages.append(text)
        current, used = [], 0

    for day, items in groups:
        for index, item in enumerate(items):
            lines = event_line(item, day, width, secondary)
            if len(lines) + 1 > height:
                lines = lines[:1]  # unusually short terminal: preserve event title
            new_day = index == 0
            # Each page containing a day starts with that day's heading.
            heading_needed = new_day or used == 0
            separator = 1 if new_day and used else 0
            required = len(lines) + int(heading_needed) + separator
            if used and used + required > height:
                flush()
                heading_needed, separator = True, 0
            if not current and starts is not None:
                starts.append((day, item.start, item.end, item.uid, item.title))
            if separator:
                current.append(Text(""))
                used += 1
            if heading_needed:
                suffix = " (cont.)" if index > 0 else ""
                heading = Text(day.strftime("%A, %B %-d") + suffix, style="bold " + accent)
                heading.truncate(width, overflow="ellipsis")
                current.append(heading)
                used += 1
            current.extend(lines)
            used += len(lines)
    flush()
    return pages or [Text("No events in the selected range", style=secondary)]


class DayCell(Static):
    def __init__(self) -> None:
        super().__init__("", classes="day")
        self.day: date | None = None

    def on_click(self, event: events.Click) -> None:
        if self.day is not None:
            event.stop()
            self.app.open_agenda(self.day)


class AgendaBody(Static):
    def on_click(self, event: events.Click) -> None:
        url = event.style.meta.get("meeting_url")
        if event.button == 1 and isinstance(url, str) and valid_web_url(url):
            event.stop()
            webbrowser.open(url)

    def on_resize(self) -> None:
        self.app.schedule_reflow()


