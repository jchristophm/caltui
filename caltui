# Query only the colors used by this UI: defaults, blue, cyan and bright white.
PALETTE_KEYS = {"10", "11", "4;4", "4;6", "4;15"}
COLOR_QUERY = "".join(f"\x1b]{key};?\x1b\\" for key in sorted(PALETTE_KEYS))
RGB = tuple[int, int, int]


def luminance(color: RGB) -> float:
    def linear(channel: int) -> float:
        value = channel / 255
        return value / 12.92 if value <= 0.04045 else ((value + 0.055) / 1.055) ** 2.4
    return sum(weight * linear(channel) for weight, channel in
               zip((0.2126, 0.7152, 0.0722), color))


def contrast(first: RGB, second: RGB) -> float:
    low, high = sorted((luminance(first), luminance(second)))
    return (high + 0.05) / (low + 0.05)


def blend(first: RGB, second: RGB, step: int) -> RGB:
    return tuple(round(a + (b - a) * step / 255) for a, b in zip(first, second))


def readable(color: RGB, background: RGB) -> RGB:
    """Keep compliant colors; otherwise make the smallest blend toward black/white."""
    for step in range(256):
        candidates = [blend(color, end, step) for end in ((0, 0, 0), (255, 255, 255))]
        for candidate in candidates:
            if contrast(candidate, background) >= 4.5:
                return candidate
    raise AssertionError("Black or white must meet AA on an sRGB background")


def text_colors(palette: dict[str, RGB]) -> dict[str, RGB]:
    background = palette["11"]
    primary = readable(palette["10"], background)
    # Scan the quantized sRGB blend from background toward foreground. The first
    # passing color is the dimmest blend, also for light terminal backgrounds.
    secondary = next(color for step in range(256)
                     if contrast(color := blend(background, primary, step), background) >= 4.5)
    return {"primary": primary, "secondary": secondary,
            "accent": readable(palette["4;6"], background),
            "selection": readable(palette["4;15"], palette["4;4"])}


def hex_color(color: RGB) -> str:
    return "#%02x%02x%02x" % color


class PaletteReport(Message):
    def __init__(self, key: str, color: RGB) -> None:
        super().__init__()
        self.key, self.color = key, color


class ColorReplies:
    """Separate OSC replies from Textual input, including fragmented reads.

    This runs inside the existing input thread; it never reads stdin itself.
    Ordinary keys, mouse input and bracketed paste go to XTermParser unchanged.
    Unknown OSCs are consumed too: they are terminal messages, not key presses.
    """
    def __init__(self, report) -> None:
        self.report = report
        self.pending = ""
        self.osc = False
        self.discard = False
        self.tail = ""
        self.paste = False
        self.since = 0.0

    def feed(self, data: str) -> str:
        output = []
        for char in data:
            if self.osc:
                self.pending += char
                if char == "\a" or self.pending.endswith("\x1b\\"):
                    if not self.discard:
                        payload = self.pending[2:-1] if char == "\a" else self.pending[2:-2]
                        match = re.fullmatch(r"(10|11|4;(?:4|6|15));rgb:([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})", payload)
                        if match:
                            key, *channels = match.groups()
                            color = tuple(round(int(c, 16) * 255 / (16 ** len(c) - 1)) for c in channels)
                            self.report(PaletteReport(key, color))
                    self.pending, self.osc, self.discard = "", False, False
                elif len(self.pending) > 256:
                    # Bound memory for malformed input, retaining ST detection.
                    self.pending, self.discard = self.pending[-1:], True
                continue
            if self.pending:
                if char == "]" and not self.paste:
                    self.pending += char
                    self.osc = True
                    self.since = clock.monotonic()
                    continue
                output.append(self.pending)
                self.pending = ""
            self.tail = (self.tail + char)[-6:]
            if self.tail.endswith("\x1b[200~"):
                self.paste = True
            elif self.tail.endswith("\x1b[201~"):
                self.paste = False
            if char == "\x1b":
                self.pending = char
                self.since = clock.monotonic()
            else:
                output.append(char)
        return "".join(output)

    def tick(self) -> str:
        if self.osc and clock.monotonic() - self.since >= 0.5:
            # An unterminated response must not capture subsequent keyboard input.
            self.pending, self.osc, self.discard = "", False, False
        if self.pending == "\x1b" and not self.osc and clock.monotonic() - self.since >= 0.03:
            self.pending = ""
            return "\x1b"
        return ""


if LinuxDriver is not None:
    class ColorDriver(LinuxDriver):
        def run_input_thread(self) -> None:
            # Textual 8 has no OSC response hook. Keep its single input reader,
            # UTF-8 decoder and parser; intercept OSC before its key fallback.
            parser = XTermParser(self._debug)
            replies = ColorReplies(self.process_message)
            decode = getincrementaldecoder("utf-8")().decode
            with selectors.SelectSelector() as selector:
                selector.register(self.fileno, selectors.EVENT_READ)
                while not self.exit_event.is_set():
                    for _key, _mask in selector.select(0.03):
                        data = os.read(self.fileno, 4096)
                        if not data:
                            return
                        filtered = replies.feed(decode(data))
                        if filtered:
                            for message in parser.feed(filtered):
                                self.process_message(message)
                    pending = replies.tick()
                    if pending:
                        for message in parser.feed(pending):
                            self.process_message(message)
                    for message in parser.tick():
                        self.process_message(message)
else:
    ColorDriver = None


def scrub(value: object) -> str:
    """Single safe display line from potentially untrusted calendar text."""
    return " ".join(str(value or "").split()).replace("\x1b", "")


def shorten(text: str, width: int) -> Text:
    result = Text(text)
    result.truncate(max(1, width), overflow="ellipsis")
    return result


def month_shift(day: date, offset: int) -> date:
    total = day.year * 12 + (day.month - 1) + offset
    year, month = divmod(total, 12)
    return date(year, month + 1, 1)


def local_datetime(value: date | datetime) -> datetime:
    if isinstance(value, datetime):
        return (value if value.tzinfo else value.replace(tzinfo=LOCAL_TZ)).astimezone(LOCAL_TZ)
    return datetime.combine(value, time.min, tzinfo=LOCAL_TZ)


@dataclass(frozen=True)
class Appointment:
    start: datetime
    end: datetime  # exclusive
    all_day: bool
    title: str
    location: str
    uid: str

    def days(self, begin: date, stop: date) -> list[date]:
        first = max(begin, self.start.date())
        last = min(stop - timedelta(days=1), (self.end - timedelta(microseconds=1)).date())
        if first > last:
            return []
        return [first + timedelta(days=i) for i in range((last - first).days + 1)]


class CombinedFeed:
    """Keep recurrence expansion isolated by source, even when UIDs coincide."""
    def __init__(self, queries) -> None:
        self.queries = tuple(queries)

    def between(self, begin, stop):
        return [item for query in self.queries for item in query.between(begin, stop)]


def parse_appointments(query: object, begin: date, stop: date) -> list[Appointment]:
    """Use recurrence-aware library (RRULE, EXDATE, RECURRENCE-ID) for a finite range."""
    results: list[Appointment] = []
    for item in query.between(begin, stop):
        if str(item.get("STATUS", "")).upper() == "CANCELLED":
            continue
        if "DTSTART" not in item:
            continue
        raw_start = item.decoded("DTSTART")
        all_day = not isinstance(raw_start, datetime)
        if "DTEND" in item:
            raw_end = item.decoded("DTEND")
        elif "DURATION" in item:
            raw_end = raw_start + item.decoded("DURATION")
        else:
            raw_end = raw_start + timedelta(days=1) if all_day else raw_start + timedelta(hours=1)
        start = local_datetime(raw_start)
        end = local_datetime(raw_end)
        if end <= start:
            end = start + timedelta(days=1) if all_day else start + timedelta(minutes=1)
        if end <= local_datetime(begin) or start >= local_datetime(stop):
            continue
        results.append(Appointment(
            start, end, all_day, scrub(item.get("SUMMARY", "(Untitled)")),
            scrub(item.get("LOCATION", "")), scrub(item.get("UID", ""))
        ))
    return sorted(results, key=lambda x: (x.start.timestamp(), x.end.timestamp(), x.title))


